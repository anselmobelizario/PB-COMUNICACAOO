{
  "name": "hero-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-files.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist/ssr && node scripts/prerender.mjs",
    "build:full": "npm run optimize-images && npm run generate-assets && npm run build",
    "generate-assets": "node scripts/generate-og-image.mjs && node scripts/generate-favicons.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-gallery-ratios": "node scripts/generate-gallery-ratios.mjs",
    "generate-asset-versions": "node scripts/generate-asset-versions.mjs",
    "generate-avif": "node scripts/generate-avif.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.1"
  }
}
